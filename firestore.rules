rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile
    match /users/{userId} {
      allow read, get, list: if isOwner(userId);
      allow create, update, delete: if isOwner(userId) && isValidId(userId);

      // Resumes subcollection
      match /resumes/{resumeId} {
        allow read, get, list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(resumeId);
      }
    }
  }
}
